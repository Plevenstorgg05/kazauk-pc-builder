  "rules": [
    {
      "id": "socket",
      "check": "cpu.socket == motherboard.socket",
      "fail": "incompatible"
    },
    {
      "id": "memory_type",
      "check": "memory.type == motherboard.memory_type",
      "fail": "incompatible"
    },
    {
      "id": "dimm_type",
      "check": "memory.dimm_type == motherboard.dimm_type (desktop = DIMM)",
      "fail": "incompatible"
    },
    {
      "id": "board_form_factor",
      "check": "motherboard.form_factor in case.motherboard_support",
      "fail": "incompatible"
    },
    {
      "id": "gpu_length",
      "check": "gpu.length_mm <= case.gpu_max_mm",
      "fail": "incompatible",
      "if_missing": "insufficient_data",
      "if_conflict": "needs_verification (use the lowest conflicting value to be safe)"
    },
    {
      "id": "cooler_required",
      "check": "cpu.cooler_included OR a cooler is selected",
      "fail": "incompatible (missing part)"
    },
    {
      "id": "boxed_cooler",
      "check": "cooler.only_with_cpu == cpu.id",
      "fail": "incompatible"
    },
    {
      "id": "cooler_socket",
      "check": "cpu.socket in cooler.sockets",
      "fail": "incompatible",
      "if_missing": "insufficient_data"
    },
    {
      "id": "radiator_fit",
      "check": "cooler.radiator_mm <= max of case.radiators[].max_mm",
      "fail": "incompatible",
      "if_missing": "insufficient_data"
    },
    {
      "id": "psu_wattage",
      "check": "psu.wattage >= gpu.recommended_psu_w",
      "fail": "warning (below manufacturer recommendation)"
    },
    {
      "id": "psu_headroom",
      "check": "(cpu.tdp_w + gpu.board_power_w + 100) * 1.3 <= psu.wattage",
      "fail": "warning",
      "note": "100W for the rest of the system and 1.3x headroom are placeholder values - the owner should set them"
    },
    {
      "id": "gpu_connectors",
      "check": "psu.connectors supply gpu.power_connectors",
      "if_missing": "insufficient_data",
      "note": "PSU connector counts not captured yet - this will show amber for every build until filled in"
    }
  ],
